
#include <stdio.h>
#include <string.h>

struct SinhVien {
    char hoTen[50];
    char maSV[20];
    float diem1, diem2, diem3;
};

int main() {
    struct SinhVien sv[100];
    struct SinhVien *p;
    int n, i;

    printf("Nhap so luong sinh vien: ");
    scanf("%d", &n);
    getchar();


    for (i = 0; i < n; i++) {
        p = &sv[i];

        printf("\nNhap sinh vien thu %d:\n", i + 1);

        printf("Ho ten: ");
        fgets(p->hoTen, sizeof(p->hoTen), stdin);
        p->hoTen[strcspn(p->hoTen, "\n")] = '\0';

        printf("Ma sinh vien: ");
        fgets(p->maSV, sizeof(p->maSV), stdin);
        p->maSV[strcspn(p->maSV, "\n")] = '\0';

        printf("Diem 1: ");
        scanf("%f", &p->diem1);

        printf("Diem 2: ");
        scanf("%f", &p->diem2);

        printf("Diem 3: ");
        scanf("%f", &p->diem3);

        getchar();
    }


    printf("\n========== DANH SACH SINH VIEN ==========\n");
    printf("%-25s %-15s %-10s %-10s %-10s\n",
           "Ho ten", "Ma SV", "Diem 1", "Diem 2", "Diem 3");

    for (i = 0; i < n; i++) {
        p = &sv[i];

        printf("%-25s %-15s %-10.2f %-10.2f %-10.2f\n",
               p->hoTen, p->maSV,
               p->diem1, p->diem2, p->diem3);
    }

    return 0;
}
