#include<stdio.h>
#include<stdlib.h>

void nhap(int **a,int n ,int m){
	int i,j;
	for(i=0;i<n ;i++){
		for(int j=0;j<m;j++)
		 scanf("%d", *(a+i) + j);
	}
}
void in(int **a ,int n ,int m){
	int i,j;
	for(i=0;i<n ;i++){
		for(int j=0;j<m;j++){
		
		 printf("%d ", *(*(a+i)+j));}
		 printf("\n");
	}
	
}
int main(){
	int **a;
	int n,m;
	scanf("%d%d",&n,&m);
	a=(int**)malloc(n*sizeof(int*));
	for(int i= 0;i<n ;i++)
	a[i]=(int*)malloc(m*sizeof(int));
	nhap(a,n,m);
	in(a,n,m);
	for(int i=0;i<n;i++)
	free(a[i]);
	free(a);
	}
